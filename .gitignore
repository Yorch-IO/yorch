# App runtime state (workspace volumes, generated compose env, secrets)
infra/.env
infra/workspace/
infra/secrets.env
# Pool identifiers rather than secrets, but still machine-local: which pool a
# checkout points at is a deployment fact, not a property of the code.
infra/cognito.env
infra/qdrant_storage/

# Tauri build-time generated schemas
app/src-tauri/gen/

# Provider secrets and machine-local caches.
# Matched by name anywhere rather than by path: the app writes an empty
# `secrets.env` beside whatever directory it is launched from, so enumerating
# the known ones leaves the next one untracked-but-committable.
secrets.env
**/secrets.env
worker/cache/

# The embedding cache is 1538 raw float32 blobs and regenerable. `cache/correct/`
# stays tracked beside it, deliberately: a correction costs generation tokens and
# its cache is what survives an interrupted run, while an embedding is cheap
# enough ($0.000068 for a page) that carrying 19 MB of vectors in history buys
# nothing.
docaget/cache/embed/

# Testing books repository (maintained separately at git@github.com:kh31r0n/libros.git)
docaget/libros/

# Book exports by format (organized by book in libros repository)
exports/

# Scripts for book generation (maintained in libros repository)
scripts/
