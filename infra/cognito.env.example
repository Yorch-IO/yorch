# Company Brain's Cognito pool, for the paid control plane.
#
# Copy to `cognito.env` and fill in from the Terraform outputs in
# ../../yorch-aws-platform:
#
#   terraform -chdir=envs/prod output -raw brain_cognito_user_pool_id
#   terraform -chdir=envs/prod output -raw brain_cognito_client_id
#   terraform -chdir=envs/prod output -raw brain_cognito_hosted_ui_domain
#
# All three, every time. The pool id and the client id survive a platform
# rename — a pool name is mutable — but the hosted-UI domain is replaced by one,
# so copying only the first two leaves the login pointing at a domain that no
# longer resolves. That is exactly what the vervux.com cutover did.
#
# These are public values. A pool id and a client id identify a pool; they
# authorize nothing, which is why they travel in a plain file and reach a
# browser in a redirect URL. The pool holds no client secret — the desktop app
# is a public client using authorization-code + PKCE.
#
# Not in `infra/.env`, and that is not a preference: the desktop app rewrites
# that file from scratch on every launch, so anything added to it disappears the
# next time somebody opens the app.
#
# Compose reads this at `up` time, so changing it needs the service recreated.

BRAIN_COGNITO_REGION=us-west-2
BRAIN_COGNITO_USER_POOL_ID=
BRAIN_COGNITO_CLIENT_ID=
BRAIN_COGNITO_HOSTED_UI_DOMAIN=

# The browser client, when there is one. Optional: a stack with no web app
# leaves it empty and the plane validates a single audience. Two clients exist
# because a redirect URI must match exactly — the desktop app's callback is a
# loopback listener and the web app's is https://brain.vervux.com/auth/callback,
# and one client cannot safely hold both.
BRAIN_COGNITO_WEB_CLIENT_ID=
